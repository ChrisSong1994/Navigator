{
  "manifest_version": 3,
  "name": "导航精灵",
  "description": "支持跨设备同步配置和全局搜索的新标签页导航主页。",
  "version": "0.0.8",
  "permissions": ["storage", "bookmarks"],
  "host_permissions": [
    "https://www.google.com/*",
    "https://www.google.com.hk/*",
    "https://www.baidu.com/*",
    "https://cn.bing.com/*",
    "https://www.bing.com/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "action": {
    "default_title": "打开导航精灵"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
