// 全局源配置信息
// 由 `pnpm import:bookmarks` 从 Chrome 书签导出生成，可手工增删改；改完执行 `pnpm refresh` 同步到 src/global_runtime.json
{
  settings: {
    siteTitle: "导航精灵",
    siteLogo: "", // 站点 logo，base64 data URL 或图片地址，留空则不显示
    primaryColor: "", // 留空表示使用内置默认主色 #2f54eb
    linkFontSize: 14, // 链接文字字号 12~20
    linkCardGap: 16, // 卡片之间 / 列表行之间的间距 4~48
    themeMode: "system", // system | light | dark
    viewMode: "card", // card | list
    searchEngine: "google", // google | baidu | bing
    searchOpenInNewTab: true, // 搜索结果 / 直接输入的网址是否新开窗口
    linkOpenInNewTab: true, // 点击导航链接是否新开窗口
  },
  groups: {
    "default": {
      title: "常用",
      links: [
        // icon 为 base64 data URL 或图片地址，留空则用首字母色块兜底
        { icon: "", href: "https://github.com/", text: "GitHub" },
        { icon: "", href: "https://developer.mozilla.org/", text: "MDN Web Docs" },
        { icon: "", href: "https://react.dev/", text: "React" },
        { icon: "", href: "https://vite.dev/", text: "Vite" },
        { icon: "", href: "https://ant.design/", text: "Ant Design" },
        { icon: "", href: "https://tailwindcss.com/", text: "Tailwind CSS" },
      ],
    },
    "学习/前端": {
      title: "学习 / 前端",
      links: [
        { icon: "", href: "https://zh.javascript.info/", text: "JavaScript.info 中文" },
        { icon: "", href: "https://tc39.es/ecma262/", text: "ECMAScript 标准" },
        { icon: "", href: "https://developer.mozilla.org/zh-CN/docs/Web/CSS", text: "MDN CSS" },
        { icon: "", href: "https://web.dev/", text: "web.dev" },
        { icon: "", href: "https://www.w3.org/", text: "W3C" },
        { icon: "", href: "https://css-tricks.com/", text: "CSS-Tricks" },
        { icon: "", href: "https://www.smashingmagazine.com/", text: "Smashing Magazine" },
        { icon: "", href: "https://frontendmasters.com/", text: "Frontend Masters" },
        { icon: "", href: "https://eslint.org/", text: "ESLint" },
        { icon: "", href: "https://prettier.io/", text: "Prettier" },
        { icon: "", href: "https://vitest.dev/", text: "Vitest" },
        { icon: "", href: "https://playwright.dev/", text: "Playwright" },
      ],
    },
    "开发/工具": {
      title: "开发 / 工具",
      links: [
        { icon: "", href: "https://nodejs.org/", text: "Node.js" },
        { icon: "", href: "https://www.npmjs.com/", text: "npm" },
        { icon: "", href: "https://pnpm.io/", text: "pnpm" },
        { icon: "", href: "https://www.typescriptlang.org/", text: "TypeScript" },
        { icon: "", href: "https://www.postman.com/", text: "Postman" },
