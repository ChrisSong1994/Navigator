{
  "name": "navigator-spirit",
  "private": true,
  "version": "0.0.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check": "pnpm lint && pnpm check:merge && pnpm check:storage && pnpm check:wallpaper && pnpm refresh --check",
    "refresh": "node scripts/refresh.mjs",
    "import:bookmarks": "node scripts/import-bookmarks.mjs",
    "build:extension": "tsc -b && vite build && node scripts/build-extension.mjs",
    "check:merge": "node scripts/check-merge.mjs",
    "check:storage": "node scripts/check-storage.mjs",
    "check:wallpaper": "node scripts/check-wallpaper.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "antd": "^6.6.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.1.31",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "json5": "^2.2.3",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
